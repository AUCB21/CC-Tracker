# Copy to .env.local and fill in.

# Supabase project (Dashboard -> Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side secret (sb_secret_*). Bypasses RLS. Never expose to the browser.
# Legacy `SUPABASE_SERVICE_ROLE_KEY` is still read as a fallback.
SUPABASE_SECRET=sb_secret_...

# Shared secret for the /api/ingest/* endpoints.
# Any long random string, e.g. `openssl rand -hex 32` on mac/linux,
# or run `[Guid]::NewGuid().ToString("N")` in PowerShell.
CC_TRACKER_API_KEY=change-me
